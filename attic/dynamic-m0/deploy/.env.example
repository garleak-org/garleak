# Copy to deploy/.env and replace every placeholder. Never commit .env.
# Nothing in this file is a real credential.

GARLEAK_ENV=development

# PostgreSQL
POSTGRES_USER=garleak
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=garleak

# Signed session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GARLEAK_SESSION_SECRET=change-me-session-secret
# Must be true behind HTTPS (and is enforced when GARLEAK_ENV=production).
GARLEAK_SESSION_COOKIE_SECURE=false

# Where the browser lands after login.
GARLEAK_WEB_BASE_URL=http://localhost:3000

# ORCID OAuth. Register a sandbox client at https://sandbox.orcid.org/developer-tools
# with the redirect URI below. Switch the base URL to https://orcid.org for production.
GARLEAK_ORCID_BASE_URL=https://sandbox.orcid.org
GARLEAK_ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
GARLEAK_ORCID_CLIENT_SECRET=change-me-orcid-client-secret
GARLEAK_ORCID_REDIRECT_URI=http://localhost:8000/auth/orcid/callback

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=garleak-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
GARLEAK_S3_BUCKET=garleak

# Typesense
TYPESENSE_API_KEY=change-me-typesense-key

# Host ports
API_PORT=8000
WEB_PORT=3000
MINIO_CONSOLE_PORT=9001
